# `off` writes 1 to no_turbo (boost disabled); `on` writes 0. Cleared on reboot.
intel-turbo() {
  local knob=/sys/devices/system/cpu/intel_pstate/no_turbo
  if [[ ! -e $knob ]]; then
    echo "intel-turbo: Intel P-state turbo control is not available on this machine" >&2
    return 1
  fi
  case ${1:-} in
    off)
      echo 1 | sudo tee "$knob" >/dev/null || return 1
      echo "intel turbo off (base clocks until reboot)"
      ;;
    on)
      echo 0 | sudo tee "$knob" >/dev/null || return 1
      echo "intel turbo on"
      ;;
    *)
      echo "usage: intel-turbo on|off" >&2
      return 1
      ;;
  esac
}
